# CivicPulse AI Environment Configuration
PROJECT_NAME="CivicPulse AI"
API_V1_STR="/api/v1"
SECRET_KEY="change-me-in-backend-.env"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL="sqlite:///./civicpulse.db"
UPLOAD_DIR="./uploads"
ENVIRONMENT="development"
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# LLM chain for voice/typed report extraction (category, sector, landmark).
# Order: Gemini -> Groq -> OpenRouter. Leave a key empty to skip that provider;
# with no keys the built-in keyword extractor is used. Put real keys in backend/.env
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.1-flash-lite"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemma-4-31b-it:free"

# TaskVox AI: voice-calls a field worker when a municipal officer assigns them a task.
# Create an agent in the TaskVox dashboard whose script can use the variables
# worker_name, incident_number, issue, category, sector, landmark, priority,
# description, instructions. Put real values in backend/.env
TASKVOX_API_KEY=""
TASKVOX_AGENT_ID=""
TASKVOX_CALL_WORKERS="Vikram Singh"
